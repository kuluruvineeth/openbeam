{
  "name": "openplane",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.11.3",
      "@trpc/server": "^11.6.0",
      "dotenv": "^17.2.2",
      "zod": "^4.2.1",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "lucide-react": "^0.546.0",
      "next": "16.1.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@trpc/client": "^11.6.0",
      "@prisma/client": "^6.15.0",
      "@tailwindcss/postcss": "^4.1.10",
      "@types/node": "^20",
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "tailwindcss": "^4.1.10"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @openplane/db db:push",
    "db:studio": "turbo -F @openplane/db db:studio",
    "db:generate": "turbo -F @openplane/db db:generate",
    "db:migrate": "turbo -F @openplane/db db:migrate",
    "db:start": "turbo -F @openplane/db db:start",
    "db:watch": "turbo -F @openplane/db db:watch",
    "db:stop": "turbo -F @openplane/db db:stop",
    "db:down": "turbo -F @openplane/db db:down"
  },
  "dependencies": {
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "dotenv": "^17.2.2",
    "input-otp": "^1.4.2",
    "vaul": "^1.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "@biomejs/biome": "2.3.4",
    "ultracite": "6.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5",
    "@types/bun": "^1.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.2"
}
