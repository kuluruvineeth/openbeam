{
  "name": "openplane",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.11.3",
      "@trpc/server": "^11.6.0",
      "dotenv": "^17.2.2",
      "zod": "^4.2.1",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "lucide-react": "^0.546.0",
      "next": "16.1.0",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@trpc/client": "^11.6.0",
      "@prisma/client": "^6.15.0",
      "@tailwindcss/postcss": "^4.1.10",
      "@types/node": "^20",
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "tailwindcss": "^4.1.10"
    }
  },
  "scripts": {
    "check": "biome check --write .",
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:cli": "turbo -F cli build --continue",
    "db:push": "turbo -F @openplane/db db:push",
    "db:studio": "turbo -F @openplane/db db:studio",
    "db:generate": "turbo -F @openplane/db db:generate",
    "db:migrate": "turbo -F @openplane/db db:migrate",
    "db:start": "turbo -F @openplane/db db:start",
    "db:watch": "turbo -F @openplane/db db:watch",
    "db:stop": "turbo -F @openplane/db db:stop",
    "db:down": "turbo -F @openplane/db db:down",
    "test": "bun test ./apps/ ./packages/ai/ ./packages/api/ ./packages/db/ ./packages/redis/ ./packages/services/ ./packages/types/ ./packages/ui/ ./packages/vespa/",
    "test:temporal": "cd packages/temporal && bun run test",
    "test:all": "bun run test && bun run test:temporal",
    "cli:build": "turbo -F cli build",
    "cli:test": "turbo -F cli test",
    "cli:lint": "turbo -F cli lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.0",
    "@webbuf/blake3": "^3.5.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/bun": "^1.2.6",
    "fast-check": "^4.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5",
    "turbo": "^2.5.4",
    "ultracite": "6.3.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.2"
}
