      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#3b82f6",
            "mode": "fixed"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(queue_processing_lag_seconds{worker_type=~\"$connector_type\"})",
          "refId": "A"
        }
      ],
      "title": "Queue Processing Lag (max)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (rate(sync_documents_total{worker_type=~\"$connector_type\",status=~\"success|completed\"}[5m]))",
          "legendFormat": "{{worker_type}} docs/s",
          "refId": "A"
        }
      ],
      "title": "Sync Throughput by Connector",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 6,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type, status) (rate(sync_jobs_total{worker_type=~\"$connector_type\"}[5m]))",
          "legendFormat": "{{worker_type}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "Sync Jobs by Status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "id": 7,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, worker_type) (rate(sync_duration_seconds_bucket{worker_type=~\"$connector_type\"}[5m])))",
          "legendFormat": "{{worker_type}} p95",
          "refId": "A"
        }
      ],
      "title": "Sync Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (rate(rate_limit_hits_total{worker_type=~\"$connector_type\"}[5m]))",
          "legendFormat": "{{worker_type}} rate limit hits/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (rate(fence_conflicts_total{worker_type=~\"$connector_type\"}[5m]))",
          "legendFormat": "{{worker_type}} fence conflicts/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (worker_type) (rate(sync_jobs_total{worker_type=~\"$connector_type\",status=~\"retry\"}[5m]))",
          "legendFormat": "{{worker_type}} retries/s",
          "refId": "C"
        }
      ],
      "title": "Retry / Rate Limit / Fence Conflicts",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(25, sum(rate(sync_jobs_total{worker_type=~\"$connector_type\",status=~\"failed|error|retry\"}[5m])) by (worker_type, task_queue, status))",
          "format": "table",
          "refId": "A"
        }
      ],
      "title": "Top Failing Queues",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\",env=~\"$env\",level=~\"error|warn\"} | json | connector_id=~\".+\"",
          "refId": "A"
        }
      ],
      "title": "Connector Error Logs",
      "type": "logs"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 16,
