      "id": 1,
      "title": "Error Rate by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_errors_total[5m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(application_errors_total[5m])) by (error_type)",
          "legendFormat": "{{error_type}} (app)",
