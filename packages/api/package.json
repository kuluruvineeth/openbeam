{
  "name": "@openplane/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@openplane/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@openplane/auth": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/services": "workspace:*",
    "@openplane/connectors": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@sindresorhus/slugify": "^3.0.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.1",
    "superjson": "^2.2.5",
    "zod": "catalog:"
  }
