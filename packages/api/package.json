{
  "name": "@openbeam/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@openbeam/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@openbeam/ai": "workspace:*",
    "@openbeam/auth": "workspace:*",
    "@openbeam/computer": "workspace:*",
    "@openbeam/db": "workspace:*",
    "@openbeam/integrations": "workspace:*",
    "@openbeam/orchestrations": "workspace:*",
    "@openbeam/redis": "workspace:*",
    "@openbeam/services": "workspace:*",
    "@openbeam/storage": "workspace:*",
    "@openbeam/temporal": "workspace:*",
    "@openbeam/types": "workspace:*",
    "@sindresorhus/slugify": "^3.0.0",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.0",
    "prom-client": "^15.1.1",
    "superjson": "^2.2.5",
    "zod": "catalog:"
  }
}
