{
  "name": "@openplane/services",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "default": "./src/canvas/index.ts"
    },
    "./canvas/*": {
      "types": "./dist/canvas/*.d.ts",
      "default": "./src/canvas/*.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@openplane/ai": "workspace:*",
    "@openplane/analytics": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/integrations": "workspace:*",
    "@openplane/media": "workspace:*",
    "@openplane/observability": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@openplane/storage": "workspace:*",
    "@openplane/types": "workspace:*",
    "@openplane/vespa": "workspace:*",
    "@slack/web-api": "^7.8.0",
    "ai": "^6.0.26",
    "ajv": "^8.14.0",
    "ejs": "^3.1.10",
    "handlebars": "^4.7.8",
    "hash-wasm": "^4.12.0",
    "jmespath": "^0.16.0",
    "jose": "^6.1.3",
    "livekit-server-sdk": "^2.15.0",
    "jsonata": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "mustache": "^4.2.0",
    "mysql2": "^3.14.5",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "^1.4.3-r.2"
  },
  "devDependencies": {
    "@openplane/config": "workspace:*",
    "@types/ejs": "^3.1.5",
    "@types/jmespath": "^0.15.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mustache": "^4.2.6",
    "@types/pg": "^8.15.2",
    "fast-check": "^4.1.1",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
