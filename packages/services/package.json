{
  "name": "@openplane/services",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openplane/ai": "workspace:*",
    "@openplane/analytics": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/integrations": "workspace:*",
    "@openplane/media": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@openplane/storage": "workspace:*",
    "@openplane/vespa": "workspace:*",
    "@slack/web-api": "^7.8.0",
    "ai": "^6.0.26",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openplane/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
