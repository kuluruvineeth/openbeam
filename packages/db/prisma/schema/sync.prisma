enum SyncTrigger {
  SCHEDULED
  MANUAL
  WEBHOOK
}

enum SyncCategory {
  FULL
  INCREMENTAL
}

model SyncJob {
  id                  String        @id @default(cuid()) @map("_id")
  connectorId         String
  
  // Job Configuration & State
  type                SyncCategory
  status              ConnectorStatus @default(SYNCING) // Using ConnectorStatus or separate SyncStatus? Drizzle used SyncJobStatus
  trigger             SyncTrigger     @default(SCHEDULED)
  config              Json            @default("{}")
  
  // Timing
  lastRanAt           DateTime?
  nextRunAt           DateTime?
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  connector           Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  history             SyncHistory[]

  @@index([connectorId])
  @@index([status])
  @@map("sync_job")
}

model SyncHistory {
  id                  String        @id @default(cuid()) @map("_id")
  syncJobId           String
  connectorId         String        // Denormalized for easy access
  
  // Execution Stats
  status              ConnectorStatus // Or SyncStatus
  errorMessage        String?
  dataAdded           Int           @default(0)
  dataUpdated         Int           @default(0)
  dataDeleted         Int           @default(0)
  summary             Json          @default("{}")
  
  // Timing
  startedAt           DateTime      @default(now())
  finishedAt          DateTime?
  durationMs          Int?

  syncJob             SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  connector           Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([connectorId])
  @@index([startedAt])
  @@map("sync_history")
}

model SyncCursor {
  id            String   @id @default(cuid()) @map("_id")
  connectorId   String
  resource      String
  cursor        String?
  lastSyncedAt  DateTime @default(now())

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, resource])
  @@map("sync_cursor")
}

model ConnectorAuditLog {
  id          String   @id @default(cuid()) @map("_id")
  connectorId String
  userId      String
  action      String   // CREATED, UPDATED, DELETED, SYNCED, PAUSED, RESUMED
  changes     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([createdAt])
  @@map("connector_audit_log")
}

