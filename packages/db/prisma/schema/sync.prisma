enum SyncTrigger {
  SCHEDULED
  MANUAL
  WEBHOOK
  REALTIME
  BACKFILL
  RETRY
}

enum SyncCategory {
  FULL
  INCREMENTAL
  DELTA
  REPAIR
}

enum SyncJobStatus {
  PENDING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum SyncEventType {
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  JOB_CANCELLED
  JOB_TIMEOUT
  PHASE_STARTED
  PHASE_COMPLETED
  RESOURCE_STARTED
  RESOURCE_COMPLETED
  RESOURCE_FAILED
  DOCUMENT_INDEXED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SKIPPED
  DOCUMENT_FAILED
  RATE_LIMITED
  TOKEN_REFRESHED
  CHECKPOINT_SAVED
  CHECKPOINT_RESTORED
  ERROR
  WARNING
}

model SyncJob {
  id                  String          @id @default(cuid()) @map("_id")
  connectorId         String
  
  // === Job Identity ===
  jobType             String          @default("sync")  // "sync", "backfill", "repair", "delete"
  
  // === Job Configuration ===
  type                SyncCategory
  status              SyncJobStatus   @default(PENDING)
  trigger             SyncTrigger     @default(SCHEDULED)
  config              Json            @default("{}")
  // { resources: [...], filters: {...}, options: {...} }
  
  // === Scheduling ===
  schedule            String?         // Cron expression
  priority            Int             @default(5)  // 1-10, higher = more urgent
  
  // === Exactly-Once Execution ===
  fenceToken          Int?            // Monotonic token for fencing protocol
  lockId              String?         // Distributed lock ID
  lockExpiresAt       DateTime?
  
  // === Rate Limiting ===
  rateLimitConfig     Json?
  rateLimitedUntil    DateTime?
  
  // === Progress Tracking ===
  progress            Float           @default(0)  // 0-1
  currentPhase        String?         // "fetching", "processing", "indexing"
  currentResource     String?         // Current resource being synced
  
  itemsTotal          Int             @default(0)
  itemsProcessed      Int             @default(0)
  itemsFailed         Int             @default(0)
  
  // === Timing ===
  scheduledAt         DateTime?
  queuedAt            DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  
  lastRanAt           DateTime?
  nextRunAt           DateTime?
  
  // === Timeout ===
  timeoutMs           Int             @default(3600000)  // 1 hour default
  
  // === Error Handling ===
  errorMessage        String?
  errorCode           String?
  errorStack          String?
  retryCount          Int             @default(0)
  maxRetries          Int             @default(3)
  retryAfter          DateTime?
  
  // === Checkpointing ===
  checkpoint          Json?           // For resumable syncs
  lastCheckpointAt    DateTime?
  
  // Timestamps
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  connector           Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  history             SyncHistory[]
  events              SyncEvent[]

  @@index([connectorId])
  @@index([status])
  @@index([nextRunAt])
  @@index([priority])
  @@index([status, nextRunAt])
  @@index([connectorId, status])
  @@map("sync_job")
}

model SyncHistory {
  id                  String          @id @default(cuid()) @map("_id")
  syncJobId           String
  connectorId         String
  
  // === Execution Identity ===
  executionId         String          @unique @default(cuid())  // For idempotency
  
  // === Execution Status ===
  status              SyncJobStatus
  trigger             SyncTrigger
  
  // === Results ===
  dataAdded           Int             @default(0)
  dataUpdated         Int             @default(0)
  dataDeleted         Int             @default(0)
  dataSkipped         Int             @default(0)
  dataFailed          Int             @default(0)
  
  bytesProcessed      BigInt          @default(0)
  
  // Detailed summary
  summary             Json            @default("{}")
  // { byType: { message: { added: 100 }, file: { added: 50 } }, errors: [...] }
  
  // === Errors ===
  errorMessage        String?
  errorCode           String?
  errors              Json            @default("[]")  // Array of error details
  
  // === Performance ===
  startedAt           DateTime        @default(now())
  finishedAt          DateTime?
  durationMs          Int?
  
  // Breakdown
  fetchTimeMs         Int?
  processTimeMs       Int?
  indexTimeMs         Int?
  
  // === Resource Tracking ===
  resourcesSynced     String[]        @default([])
  
  // === Metrics ===
  apiCallsMade        Int             @default(0)
  rateLimitHits       Int             @default(0)
  
  syncJob             SyncJob         @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  connector           Connector       @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([connectorId])
  @@index([startedAt])
  @@index([status])
  @@index([connectorId, startedAt])
  @@map("sync_history")
}

model SyncCursor {
  id            String   @id @default(cuid()) @map("_id")
  connectorId   String
  
  // Resource identification
  resource      String   // "messages", "files", "users", "channel:C123"
  resourceType  String?  // "channel", "folder", "repository"
  
  // Cursor value
  cursor        String?  // API cursor, timestamp, or offset
  cursorType    String   @default("timestamp")  // "timestamp", "offset", "cursor", "sync_token"
  
  // Sync state
  lastSyncedAt  DateTime @default(now())
  lastDocumentId String? // Last processed document
  
  // Metadata
  metadata      Json     @default("{}")

  connector     Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, resource])
  @@index([connectorId])
  @@map("sync_cursor")
}

model ConnectorAuditLog {
  id          String   @id @default(cuid()) @map("_id")
  connectorId String
  userId      String
  
  // Action
  action      String   // "created", "updated", "deleted", "paused", "resumed", "synced", "configured"
  
  // What changed
  changes     Json     @default("{}")
  // { field: "syncConfig", old: {...}, new: {...} }
  
  // Context
  ipAddress   String?
  userAgent   String?
  
  // Result
  success     Boolean  @default(true)
  errorMessage String?
  
  createdAt   DateTime @default(now())

  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("connector_audit_log")
}

model IndexedDocument {
  id              String   @id @default(cuid()) @map("_id")
  connectorId     String
  
  // === Document Identity ===
  externalId      String   // Connector's document ID
  vespaId         String   @unique  // Vespa document ID
  
  // === Classification ===
  documentType    String   // "message", "file", "page", "issue", etc.
  documentSubtype String?  // More specific type
  
  // === Location ===
  sourceId        String?  // Channel, folder, database ID
  sourcePath      String?  // Full path
  parentId        String?  // Parent document ID (for hierarchy)
  
  // === Content Tracking ===
  checksum        String?  // SHA-256 of content
  lastChecksum    String?  // Previous checksum
  contentLength   Int?     // Content size in chars
  
  // === Sync State ===
  indexedAt       DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt
  syncVersion     Int      @default(1)
  
  // Was this deleted from source?
  deletedFromSource Boolean @default(false)
  deletedAt        DateTime?
  
  // === Metadata Cache ===
  title           String?
  authorId        String?
  createdAtSource DateTime?
  updatedAtSource DateTime?
  
  metadata        Json     @default("{}")
  
  connector       Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  
  @@unique([connectorId, externalId])
  @@index([connectorId, documentType])
  @@index([connectorId, checksum])
  @@index([vespaId])
  @@index([sourceId])
  @@index([parentId])
  @@index([lastSyncedAt])
  @@index([deletedFromSource])
  @@map("indexed_document")
}

model SyncEvent {
  id              String          @id @default(cuid()) @map("_id")
  syncJobId       String
  
  eventType       SyncEventType
  message         String?
  
  // Context
  resource        String?
  documentId      String?
  
  // Details
  details         Json            @default("{}")
  
  // Error info
  errorCode       String?
  errorMessage    String?
  
  createdAt       DateTime        @default(now())
  
  syncJob         SyncJob         @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  
  @@index([syncJobId])
  @@index([eventType])
  @@index([createdAt])
  @@map("sync_event")
}

// --- Dead Letter Queue ---
// Store failed sync items for retry/investigation

model SyncDeadLetter {
  id              String   @id @default(cuid()) @map("_id")
  connectorId     String
  syncJobId       String?
  
  // Document info
  externalId      String
  documentType    String
  
  // Original data
  rawData         Json?
  
  // Error info
  errorType       String   // "validation", "transform", "index", "permission"
  errorMessage    String
  errorStack      String?
  
  // Retry tracking
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  lastRetryAt     DateTime?
  nextRetryAt     DateTime?
  
  // Status
  status          String   @default("pending")  // "pending", "retrying", "resolved", "abandoned"
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?  // "retried", "skipped", "manual_fix"
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([connectorId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([errorType])
  @@map("sync_dead_letter")
}

enum FileProcessingStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  PARSING
  PARSED
  INDEXING
  INDEXED
  FAILED
}

enum VideoProcessingStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  INDEXING_TWELVELABS
  INDEXED_TWELVELABS
  GENERATING_EMBEDDINGS
  INDEXING_VESPA
  INDEXED
  FAILED
}

model IndexedFile {
  id               String               @id @default(cuid()) @map("_id")
  connectorId      String
  vespaId          String               @unique
  externalId       String
  sourceMessageId  String?
  sourceChannelId  String?

  fileName         String
  mimeType         String
  fileSize         Int
  fileExtension    String?

  storageKey       String               @unique
  storageUrl       String?

  processingStatus FileProcessingStatus @default(PENDING)
  extractedText    Boolean              @default(false)
  textLength       Int?
  pageCount        Int?
  chunkCount       Int?

  lastError        String?
  errorCount       Int                  @default(0)
  checksum         String?

  uploadedAt       DateTime?
  processedAt      DateTime?
  indexedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  connector        Connector            @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  chunks           IndexedChunk[]

  @@unique([connectorId, externalId])
  @@index([processingStatus])
  @@index([mimeType])
  @@index([connectorId])
  @@map("indexed_file")
}

model IndexedChunk {
  id              String      @id @default(cuid()) @map("_id")
  fileId          String
  connectorId     String

  vespaId         String      @unique

  chunkIndex      Int

  checksum        String?
  contentLength   Int?

  indexedAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  file            IndexedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([connectorId])
  @@index([vespaId])
  @@map("indexed_chunk")
}

model IndexedVideo {
  id                  String                @id @default(cuid()) @map("_id")
  connectorId         String
  vespaId             String                @unique
  externalId          String

  sourceMessageId     String?
  sourceChannelId     String?
  fileName            String
  mimeType            String
  fileSize            Int
  fileExtension       String?

  storageKey          String                @unique
  storageUrl          String?

  twelveLabsIndexId   String?
  twelveLabsVideoId   String?

  processingStatus    VideoProcessingStatus @default(PENDING)
  durationSeconds     Int?
  thumbnailUrl        String?

  lastError           String?
  errorCount          Int                   @default(0)

  uploadedAt          DateTime?
  indexedAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  connector           Connector             @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([processingStatus])
  @@index([connectorId])
  @@map("indexed_video")
}

