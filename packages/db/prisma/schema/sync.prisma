enum SyncTrigger {
  SCHEDULED
  MANUAL
  WEBHOOK
  REALTIME
  BACKFILL
  RETRY
}

enum SyncCategory {
  FULL
  INCREMENTAL
  DELTA
  REPAIR
}

enum SyncJobStatus {
  PENDING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum SyncEventType {
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  JOB_CANCELLED
  JOB_TIMEOUT
  PHASE_STARTED
  PHASE_COMPLETED
  RESOURCE_STARTED
  RESOURCE_COMPLETED
  RESOURCE_FAILED
  DOCUMENT_INDEXED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SKIPPED
  DOCUMENT_FAILED
  RATE_LIMITED
  TOKEN_REFRESHED
  CHECKPOINT_SAVED
  CHECKPOINT_RESTORED
  ERROR
  WARNING
}

model SyncJob {
  id                  String        @id @default(cuid()) @map("_id")
  connectorId         String
  
  // Job Configuration & State
  type                SyncCategory
  status              ConnectorStatus @default(SYNCING)
  trigger             SyncTrigger     @default(SCHEDULED)
  config              Json            @default("{}")
  
  // Scheduling
  schedule            String?       // Cron expression (e.g., "0 */6 * * *")
  priority            Int           @default(5) // Job priority (1-10, higher = more urgent)
  
  // Exactly-Once Execution
  fenceToken          Int?          // Monotonic token for fencing protocol
  
  // Rate Limiting
  rateLimitConfig     Json?         // Per-connector rate limit configuration
  
  // Timing
  lastRanAt           DateTime?
  nextRunAt           DateTime?
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  connector           Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  history             SyncHistory[]
  events              SyncEvent[]

  @@index([connectorId])
  @@index([status])
  @@index([nextRunAt]) // For scheduler queries
  @@index([priority])  // For priority queue
  @@map("sync_job")
}

model SyncHistory {
  id                  String        @id @default(cuid()) @map("_id")
  syncJobId           String
  connectorId         String        // Denormalized for easy access
  
  // Execution Stats
  status              ConnectorStatus // Or SyncStatus
  errorMessage        String?
  dataAdded           Int           @default(0)
  dataUpdated         Int           @default(0)
  dataDeleted         Int           @default(0)
  summary             Json          @default("{}")
  
  // Timing
  startedAt           DateTime      @default(now())
  finishedAt          DateTime?
  durationMs          Int?

  syncJob             SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  connector           Connector     @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([connectorId])
  @@index([startedAt])
  @@map("sync_history")
}

model SyncCursor {
  id            String   @id @default(cuid()) @map("_id")
  connectorId   String
  resource      String
  cursor        String?
  lastSyncedAt  DateTime @default(now())

  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, resource])
  @@map("sync_cursor")
}

model ConnectorAuditLog {
  id          String   @id @default(cuid()) @map("_id")
  connectorId String
  userId      String
  action      String   // CREATED, UPDATED, DELETED, SYNCED, PAUSED, RESUMED
  changes     Json
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([createdAt])
  @@map("connector_audit_log")
}

model IndexedDocument {
  id              String   @id @default(cuid()) @map("_id")
  connectorId     String
  externalId      String   // Connector's document ID (Slack message ts, Notion page ID, Drive file ID, etc.)
  vespaId         String   @unique // Vespa document ID (our generated ID)
  documentType    String   // "message", "file", "page", "issue", "ticket", etc.
  sourceId        String?  // Channel, folder, database, repository ID
  indexedAt       DateTime @default(now())
  lastSyncedAt    DateTime @updatedAt
  checksum        String?  // Content hash for change detection (SHA-256)
  lastChecksum    String?  // Previous hash for change detection (NEW)
  
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  
  @@unique([connectorId, externalId])
  @@index([connectorId, documentType])
  @@index([connectorId, checksum]) // For deduplication queries
  @@index([vespaId])
  @@index([sourceId])
  @@index([lastSyncedAt]) // For cleanup queries
  @@map("indexed_document")
}

model SyncEvent {
  id              String          @id @default(cuid()) @map("_id")
  syncJobId       String
  
  eventType       SyncEventType
  message         String?
  
  // Context
  resource        String?
  documentId      String?
  
  // Details
  details         Json            @default("{}")
  
  // Error info
  errorCode       String?
  errorMessage    String?
  
  createdAt       DateTime        @default(now())
  
  syncJob         SyncJob         @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  
  @@index([syncJobId])
  @@index([eventType])
  @@index([createdAt])
  @@map("sync_event")
}

