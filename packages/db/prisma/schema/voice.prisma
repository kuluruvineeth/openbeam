model VoiceNote {
  id       String  @id @default(cuid()) @map("_id")
  userId   String
  teamId   String
  text     String  @db.Text
  audioUrl String?

  duration Int?
  context  Json?
  tags     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@map("voice_note")
}

model VoiceSettings {
  id     String @id @default(cuid()) @map("_id")
  userId String @unique

  engine      String  @default("cloud")
  model       String  @default("base.en")
  language    String  @default("en")
  formatting  Boolean @default(true)
  formatStyle String  @default("context-aware")

  shortcuts  Json     @default("{}")
  vocabulary String[] @default([])

  widgetPosition String  @default("bottom-center")
  widgetOpacity  Float   @default(0.7)
  autoHide       Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("voice_settings")
}

model VoiceSession {
  id       String  @id @default(cuid()) @map("_id")
  userId   String
  teamId   String
  roomType String
  roomName String?

  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  duration    Int?
  wordsSpoken Int       @default(0)
  toolCalls   Int       @default(0)
  status      String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([teamId, startedAt])
  @@index([status])
  @@map("voice_session")
}
