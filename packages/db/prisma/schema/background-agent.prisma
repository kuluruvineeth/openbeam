model BackgroundAgent {
  id     String @id @default(cuid()) @map("_id")
  teamId String
  userId String

  name        String
  description String?
  prompt      String  @db.Text
  preset      String  @default("researcher")

  status      BackgroundAgentStatus @default(PENDING)
  progress    Float                 @default(0)
  currentStep String?
  totalSteps  Int?

  sandboxType SandboxType @default(DAYTONA)
  sandboxId   String?
  sandboxUrl  String?

  repositoryUrl String?
  baseBranch    String?
  workingBranch String?
  worktreePath  String?

  output         String? @db.Text
  artifacts      Json    @default("[]")
  pullRequestUrl String?

  errorCode    String?
  errorMessage String?
  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)

  inputTokens      Int   @default(0)
  outputTokens     Int   @default(0)
  estimatedCostUsd Float @default(0)

  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime?
  timeoutAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkpoints BackgroundAgentCheckpoint[]
  logs        BackgroundAgentLog[]

  @@index([teamId, status])
  @@index([userId, status])
  @@index([status, timeoutAt])
  @@map("background_agent")
}

model BackgroundAgentCheckpoint {
  id      String @id @default(cuid()) @map("_id")
  agentId String

  version        Int
  state          Json  @db.JsonB
  memorySnapshot Json? @db.JsonB
  contextWindow  Json? @db.JsonB

  stepIndex   Int
  description String?

  createdAt DateTime @default(now())

  agent BackgroundAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([agentId])
  @@map("background_agent_checkpoint")
}

model BackgroundAgentLog {
  id      String @id @default(cuid()) @map("_id")
  agentId String

  level    String @default("info")
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  agent BackgroundAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("background_agent_log")
}

enum BackgroundAgentStatus {
  PENDING
  INITIALIZING
  RUNNING
  PAUSED
  AWAITING_INPUT
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum SandboxType {
  DAYTONA
  LOCAL
}
