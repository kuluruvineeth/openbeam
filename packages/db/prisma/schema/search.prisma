model SearchExperiment {
  id              String    @id @default(cuid()) @map("_id")
  teamId          String
  name            String
  description     String?
  status          String    @default("draft")
  trafficPercent  Float     @default(10)

  controlConfig   Json      @default("{}")
  treatmentConfig Json      @default("{}")

  startedAt       DateTime?
  endedAt         DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@map("search_experiment")
}

model SearchImpression {
  id              String   @id @default(cuid()) @map("_id")
  teamId          String
  userId          String
  experimentId    String?
  variant         String?

  query           String
  queryHash       String
  resultDocIds    String[]

  timing          Json?
  rrfConfig       Json?

  createdAt       DateTime @default(now())

  clicks          SearchClick[]

  @@index([teamId, createdAt])
  @@index([experimentId, createdAt])
  @@map("search_impression")
}

model SearchClick {
  id              String   @id @default(cuid()) @map("_id")
  impressionId    String
  docId           String
  position        Int

  dwellTimeMs     Int?
  feedbackType    String?

  createdAt       DateTime @default(now())

  impression      SearchImpression @relation(fields: [impressionId], references: [id], onDelete: Cascade)

  @@index([impressionId])
  @@index([docId, createdAt])
  @@map("search_click")
}

model UserSearchProfile {
  id                 String   @id @default(cuid()) @map("_id")
  userId             String
  teamId             String

  department         String?
  searchCount        Int      @default(0)
  clickCount         Int      @default(0)
  avgDwellMs         Float?

  connectorWeights   Json     @default("{}")
  authorInteractions Json     @default("{}")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("user_search_profile")
}

model LTRModel {
  id                 String    @id @default(cuid()) @map("_id")
  teamId             String
  version            String
  status             String    @default("training")

  storagePath        String
  metrics            Json      @default("{}")
  featureImportance  Json      @default("{}")

  trainingSamples    Int       @default(0)
  trainingQueries    Int       @default(0)
  trainingDurationMs Int       @default(0)

  createdAt          DateTime  @default(now())
  deployedAt         DateTime?

  @@unique([teamId, version])
  @@index([teamId, status])
  @@map("ltr_model")
}
