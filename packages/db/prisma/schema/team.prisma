model Team {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maxConnectors      Int    @default(10)
  maxTools           Int    @default(100)
  subscriptionTier   String @default("free")
  subscriptionStatus String @default("active")

  budgetMonthlyCents               Int?
  consumedMonthlyCents             Int?
  issuePrefix                      String? @unique
  issueCounter                     Int     @default(0)
  requireBoardApprovalForNewAgents Boolean @default(false)
  brandColor                       String?

  usersOnTeam            UsersOnTeam[]
  userInvites            UserInvite[]
  connectors             Connector[]
  tools                  Tool[]
  workspaces             Workspace[]
  apiKeys                ApiKey[]
  users                  User[]
  teamMediaIndex         TeamMediaIndex?
  searchExperiments      SearchExperiment[]
  entities               Entity[]
  documentPermissions    DocumentPermission[]
  groupMemberships       GroupMembership[]
  connectorScopes        ConnectorScope[]
  permissionSyncStatuses PermissionSyncStatus[]

  compositionEvents    CompositionEvent[]
  userFeedback         UserFeedback[]
  agentExecutionTraces AgentExecutionTrace[]
  savedSearches        SavedSearch[]
  shareLinks           ShareLink[]
  agentCanvases        AgentCanvas[]
  agentCanvasTemplates AgentCanvasTemplate[]
  agentCanvasSessions  AgentCanvasSession[]
  workflowAuditLogs    WorkflowAuditLog[]
  teamKnowledge        TeamKnowledge[]

  wallets         PaymentWallet[]
  pricingPolicies PaymentPricingPolicy[]
  paymentReceipts PaymentReceipt[]
  ledgerEntries   PaymentLedgerEntry[]

  voiceNotes    VoiceNote[]
  voiceSessions VoiceSession[]

  controlAgents                ControlAgent[]
  controlAgentApiKeys          ControlAgentApiKey[]
  controlAgentConfigRevisions  ControlAgentConfigRevision[]
  controlAgentRuntimeStates    ControlAgentRuntimeState[]
  controlAgentTaskSessions     ControlAgentTaskSession[]
  controlAgentWakeupRequests   ControlAgentWakeupRequest[]
  controlHeartbeatRuns         ControlHeartbeatRun[]
  controlHeartbeatRunEvents    ControlHeartbeatRunEvent[]
  controlAssets                ControlAsset[]
  controlIssues                ControlIssue[]
  controlIssueComments         ControlIssueComment[]
  controlIssueAttachments      ControlIssueAttachment[]
  controlIssueLabels           ControlIssueLabel[]
  controlIssueLabelAssignments ControlIssueLabelAssignment[]
  controlProjects              ControlProject[]
  controlProjectWorkspaces     ControlProjectWorkspace[]
  controlProjectGoals          ControlProjectGoal[]
  controlGoals                 ControlGoal[]
  controlApprovals             ControlApproval[]
  controlApprovalComments      ControlApprovalComment[]
  controlIssueApprovals        ControlIssueApproval[]
  controlCostEvents            ControlCostEvent[]
  controlActivityLogs          ControlActivityLog[]
  controlTeamSecrets           ControlTeamSecret[]
  controlCompanyMemberships    ControlCompanyMembership[]
  controlAccessGrants          ControlAccessGrant[]
  controlInvites               ControlInvite[]
  controlJoinRequests          ControlJoinRequest[]

  customConnectorDefinitions CustomConnectorDefinition[]

  contextEntries            ContextEntry[]
  contextMemoryExtractions ContextMemoryExtraction[]
  contextRelations         ContextRelation[]
  contextSessions          ContextSession[]

  @@map("team")
}

model UsersOnTeam {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("users_on_team")
}

model UserInvite {
  id        String   @id @default(cuid()) @map("_id")
  createdAt DateTime @default(now())
  teamId    String
  email     String
  role      TeamRole
  code      String   @unique
  invitedBy String
  inviter   User     @relation("SentInvites", fields: [invitedBy], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([teamId])
  @@index([email])
  @@map("user_invite")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamMediaIndex {
  id                String   @id @default(cuid()) @map("_id")
  teamId            String   @unique
  twelveLabsIndexId String   @unique
  indexName         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_media_index")
}
