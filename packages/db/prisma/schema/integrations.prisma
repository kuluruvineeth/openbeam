enum ConnectorStatus {
  ACTIVE
  INACTIVE
  ERROR
  SYNCING
  CONNECTING
  PAUSED
  RATE_LIMITED
  AUTH_EXPIRED
}

model Workspace {
  id             String       @id @default(cuid()) @map("_id")
  externalId     String       @unique
  teamId         String
  name           String
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("workspace")
}

model Connector {
  id                  String          @id @default(cuid()) @map("_id")
  teamId              String
  userId              String
  workspaceExternalId String
  name                String
  type                ConnectorType
  authType            AuthType
  app                 AppType
  config              Json
  
  // Credentials (Consolidated & Encrypted)
  encryptedCredentials String?
  credentialsIv        String?

  // Operational Fields
  status              ConnectorStatus @default(CONNECTING)
  state               Json            @default("{}")
  lastSyncedAt        DateTime?
  lastSyncStatus      String?
  lastError           String?
  lastErrorAt         DateTime?
  syncConfig          Json            @default("{}")
  webhookConfig       Json?
  rateLimits          Json?
  retryCount          Int             @default(0)
  maxRetries          Int             @default(3)
  dataResidency       String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tools         Tool[]
  oauthProvider OAuthProvider?
  syncJobs      SyncJob[]
  syncHistory   SyncHistory[]
  syncCursors   SyncCursor[]
  auditLogs     ConnectorAuditLog[]
  externalIdentities ExternalIdentity[]
  externalGroups     ExternalGroup[]
  indexedDocuments   IndexedDocument[]
  

  @@unique([teamId, workspaceExternalId, app, name])
  @@index([teamId, status])
  @@index([userId])
  @@index([app])
  @@index([status])
  @@map("connector")
}

model OAuthProvider {
  id                  String   @id @default(cuid()) @map("_id")
  connectorId         String   @unique
  clientId            String?
  clientSecret        String?  // Encrypted
  oauthScopes         String[] @default([])
  app                 AppType
  isGlobal            Boolean  @default(false)
  
  // Token Management
  accessToken         String?  // Encrypted
  refreshToken        String?  // Encrypted
  tokenExpiresAt      DateTime?
  tokenRefreshedAt    DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@map("oauth_provider")
}

model Tool {
  id             String   @id @default(cuid()) @map("_id")
  teamId         String
  connectorId    String
  externalId     String?  @unique
  toolName       String
  toolSchema     Json
  schemaVersion  String   @default("1.0.0")
  description    String?
  enabled        Boolean  @default(false)
  
  // Usage
  usageCount     Int      @default(0)
  lastUsedAt     DateTime?
  rateLimitPerHour Int?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connector    Connector    @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, connectorId, toolName])
  @@index([connectorId])
  @@map("tool")
}

model ExternalIdentity {
  id          String   @id @default(cuid()) @map("_id")
  userId      String?
  connectorId String
  externalId  String
  email       String?
  username    String?
  displayName String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  connector Connector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@index([userId])
  @@index([email])
  @@map("external_identity")
}

model ExternalGroup {
  id          String   @id @default(cuid()) @map("_id")
  connectorId String
  externalId  String
  name        String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  connector   Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, externalId])
  @@map("external_group")
}
