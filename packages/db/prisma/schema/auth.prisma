// ============================================================================
// AUTH SCHEMA
// Enhanced authentication with MFA, device tracking, and security
// ============================================================================

model User {
  id                    String    @id @default(cuid()) @map("_id")
  
  // Identity
  name                  String
  email                 String    @unique
  emailVerified         Boolean   @default(false)
  
  // Profile
  image                 String?
  firstName             String?
  lastName              String?
  phone                 String?
  bio                   String?
  
  // Preferences (quick access)
  timezone              String?
  language              String    @default("en")
  
  // Default team
  teamId                String?
  
  // Security
  mfaEnabled            Boolean   @default(false)
  mfaSecret             String?   // TOTP secret (encrypted)
  mfaSecretIv           String?
  mfaBackupCodes        String[]  @default([])  // Hashed backup codes
  
  // Password (for non-SSO users)
  passwordHash          String?
  passwordChangedAt     DateTime?
  requirePasswordChange Boolean   @default(false)
  
  // Account status
  status                String    @default("active")  // "active", "suspended", "pending_verification"
  suspendedAt           DateTime?
  suspendedReason       String?
  
  // Login tracking
  lastLoginAt           DateTime?
  lastLoginIp           String?
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  
  // Onboarding
  onboardingCompleted   Boolean   @default(false)
  onboardingStep        Int       @default(0)
  
  // Admin flags
  isSystemAdmin         Boolean   @default(false)  // Super admin across all teams
  
  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  
  // Relations
  sessions              Session[]
  accounts              Account[]
  usersOnTeam           UsersOnTeam[]
  sentInvites           UserInvite[]         @relation("SentInvites")
  team                  Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  connectors            Connector[]
  externalIdentities    ExternalIdentity[]
  devices               UserDevice[]
  
  @@index([teamId])
  @@index([status])
  @@index([email])
  @@map("user")
}

model Session {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  token         String   @unique
  
  // Session type
  sessionType   String   @default("web")  // "web", "api", "mobile", "cli"
  
  // Device info
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  
  // Location (optional)
  country       String?
  region        String?
  city          String?
  
  // Security
  isValid       Boolean  @default(true)
  isTrusted     Boolean  @default(false)  // User marked as trusted device
  mfaVerified   Boolean  @default(false)  // MFA completed for this session
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime
  lastActiveAt  DateTime @default(now())
  
  // Revocation
  revokedAt     DateTime?
  revokedReason String?  // "logout", "password_change", "suspicious", "admin"
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([isValid])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid()) @map("_id")
  userId                String
  
  // Provider info
  providerId            String    // "google", "github", "microsoft", "okta", "saml"
  accountId             String    // Provider's user ID
  
  // Tokens (encrypted)
  accessToken           String?
  accessTokenIv         String?
  refreshToken          String?
  refreshTokenIv        String?
  idToken               String?
  idTokenIv             String?
  
  // Token expiration
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  
  // OAuth details
  scope                 String?
  tokenType             String?
  
  // For password auth
  password              String?   // Hashed password
  
  // Metadata from provider
  providerAccountData   Json?     // Additional data from provider
  
  // Timestamps
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id            String    @id @default(cuid()) @map("_id")
  
  // What's being verified
  type          String    // "email", "phone", "password_reset", "mfa_setup", "invite"
  identifier    String    // Email or phone number
  
  // Verification token
  value         String    @unique
  
  // For rate limiting
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  
  // Expiration
  expiresAt     DateTime
  
  // Status
  usedAt        DateTime?
  
  // Metadata
  metadata      Json?
  
  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([identifier])
  @@index([type, identifier])
  @@index([expiresAt])
  @@map("verification")
}

// --- User Devices ---
// Track user devices for security

model UserDevice {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  
  // Device identification
  deviceId        String    @unique  // Fingerprint/unique ID
  deviceName      String?   // User-friendly name
  
  // Device info
  deviceType      String    // "desktop", "mobile", "tablet"
  os              String?   // "macOS", "Windows", "iOS", "Android"
  osVersion       String?
  browser         String?
  browserVersion  String?
  
  // Status
  isTrusted       Boolean   @default(false)
  isCurrentDevice Boolean   @default(false)
  
  // Activity
  lastSeenAt      DateTime  @default(now())
  lastIpAddress   String?
  lastLocation    String?
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([deviceId])
  @@index([lastSeenAt])
  @@map("user_device")
}

// --- Password History ---
// Prevent password reuse

model PasswordHistory {
  id              String    @id @default(cuid()) @map("_id")
  userId          String
  passwordHash    String
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@map("password_history")
}

// --- Login History ---
// Track all login attempts

model LoginHistory {
  id              String    @id @default(cuid()) @map("_id")
  userId          String?   // Null for failed attempts with unknown user
  email           String
  
  // Attempt details
  success         Boolean
  failureReason   String?   // "invalid_password", "user_not_found", "account_locked", "mfa_failed"
  
  // Method
  authMethod      String    // "password", "sso", "oauth", "mfa"
  providerId      String?   // OAuth/SSO provider
  
  // Device info
  ipAddress       String?
  userAgent       String?
  deviceId        String?
  
  // Location
  country         String?
  region          String?
  city            String?
  
  // Risk assessment
  riskScore       Float     @default(0)
  riskFactors     String[]  @default([])
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([email])
  @@index([ipAddress])
  @@index([success])
  @@index([createdAt])
  @@map("login_history")
}
