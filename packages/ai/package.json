{
  "name": "@openplane/ai",
  "version": "0.1.0",
  "description": "Pure AI package for OpenPlane - model-agnostic providers, embeddings, completions, and agents",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./src/providers/index.ts"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "default": "./src/embeddings/index.ts"
    },
    "./completion": {
      "types": "./dist/completion/index.d.ts",
      "default": "./src/completion/index.ts"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "default": "./src/agents/index.ts"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./src/tools/index.ts"
    },
    "./streaming": {
      "types": "./dist/streaming/index.d.ts",
      "default": "./src/streaming/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@ai-sdk/azure": "^3.0.2",
    "@ai-sdk/google": "^3.0.2",
    "@ai-sdk/openai": "^3.0.2",
    "@openplane/db": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@openplane/types": "workspace:*",
    "ai": "^6.0.6",
    "exa-js": "^2.3.0",
    "fuse.js": "^7.1.0",
    "prom-client": "^15.1.3",
    "tiktoken": "^1.0.22",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@openplane/config": "workspace:*",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
