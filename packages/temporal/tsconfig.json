{
  "extends": "@openbeam/config/tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "composite": true,
    "strictNullChecks": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/observability/tracing.ts",
    "src/__tests__/tracing-config.test.ts"
  ]
}
