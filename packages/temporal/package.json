{
  "name": "@openbeam/temporal",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./src/workflows/index.ts"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "default": "./src/activities/index.ts"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./src/worker/index.ts"
    },
    "./interceptors": {
      "types": "./dist/interceptors/index.d.ts",
      "default": "./src/interceptors/index.ts"
    },
    "./observability": {
      "types": "./src/observability/index.ts",
      "default": "./src/observability/index.ts"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "@openbeam/config": "workspace:*",
    "@temporalio/testing": "~1.15.0",
    "@types/bun": "latest",
    "vitest": "^2.1.9",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.3-r.2",
    "@openbeam/ai": "workspace:*",
    "@openbeam/analytics": "workspace:*",
    "@openbeam/db": "workspace:*",
    "@openbeam/media": "workspace:*",
    "@openbeam/redis": "workspace:*",
    "@openbeam/sandbox": "workspace:*",
    "@openbeam/services": "workspace:*",
    "@openbeam/storage": "workspace:*",
    "@openbeam/types": "workspace:*",
    "@openbeam/vespa": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@temporalio/activity": "~1.15.0",
    "@temporalio/client": "~1.15.0",
    "@temporalio/common": "~1.15.0",
    "@temporalio/worker": "~1.15.0",
    "@temporalio/workflow": "~1.15.0",
    "generic-pool": "^3.9.0",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  }
}
