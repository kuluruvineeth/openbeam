{
  "name": "@openbeam/sdk",
  "version": "0.1.0",
  "description": "OpenBeam TypeScript SDK — enterprise search, knowledge graph, and AI agents across 103+ connectors",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openbeam",
    "enterprise-search",
    "knowledge-graph",
    "ai-agents",
    "rag",
    "mcp",
    "connectors",
    "sdk",
    "typescript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholasgriffintn/openbeam.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://openbeam.work",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@openbeam/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
