{
  "name": "@openbeam/mcp",
  "version": "1.0.0",
  "description": "MCP server for OpenBeam database access via Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "openbeam-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "node --import tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "claude",
    "database",
    "openbeam"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@openbeam/db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@openbeam/config": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  }
}
