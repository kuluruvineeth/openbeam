<?xml version="1.0" encoding="utf-8" ?>
<services version="1.0">
  <container id="default" version="1.0">
    <document-api/>
    <search/>
    <document-processing/>

    <http>
      <server id="default" port="8080"/>
    </http>

    <nodes>
      <node hostalias="node1"/>
    </nodes>
  </container>

  <content id="content" version="1.0">
    <redundancy>1</redundancy>
    
    <documents>
      <document type="openplane_document" mode="index"/>
      <document type="entity" mode="index"/>
      <document type="media_document" mode="index"/>
      <document type="spreadsheet_document" mode="index"/>
    </documents>

    <nodes>
      <node hostalias="node1" distribution-key="0"/>
    </nodes>

    <tuning>
      <resource-limits>
        <disk>0.9</disk>
        <memory>0.9</memory>
      </resource-limits>
    </tuning>
  </content>
</services>

