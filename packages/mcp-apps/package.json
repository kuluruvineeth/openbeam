    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.0"
