{
  "name": "@openbeam/mcp-apps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && bun scripts/build-views.ts",
    "build:search": "INPUT=search vite build",
    "build:connector-dashboard": "INPUT=connector-dashboard vite build",
    "build:document-preview": "INPUT=document-preview vite build",
    "build:people": "INPUT=people vite build",
    "build:sync-status": "INPUT=sync-status vite build",
    "build:team": "INPUT=team vite build",
    "build:connector-setup": "INPUT=connector-setup vite build",
    "test": "bun test --exit --timeout 10000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.3.1",
    "@openbeam/integrations": "workspace:*",
