{
  "name": "@openplane/types",
  "version": "0.1.0",
  "description": "Shared types and Zod schemas for OpenPlane",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./src/ai/index.ts"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "default": "./src/common/index.ts"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./src/media/index.ts"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./src/search/index.ts"
    },
    "./overview": {
      "types": "./dist/overview/index.d.ts",
      "default": "./src/overview/index.ts"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./src/sync/index.ts"
    },
    "./connectors": {
      "types": "./dist/connectors/index.d.ts",
      "default": "./src/connectors/index.ts"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./src/db/index.ts"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./src/services/index.ts"
    },
    "./services/connectors/*": {
      "types": "./dist/services/connectors/*.d.ts",
      "default": "./src/services/connectors/*.ts"
    },
    "./services/connectors/events": {
      "types": "./dist/services/connectors/events.d.ts",
      "default": "./src/services/connectors/events.ts"
    },
    "./services/connectors/common/events": {
      "types": "./dist/services/connectors/common/events.d.ts",
      "default": "./src/services/connectors/common/events.ts"
    },
    "./services/connectors/common/resources": {
      "types": "./dist/services/connectors/common/resources.d.ts",
      "default": "./src/services/connectors/common/resources.ts"
    },
    "./services/connectors/common": {
      "types": "./dist/services/connectors/common/index.d.ts",
      "default": "./src/services/connectors/common/index.ts"
    },
    "./services/ai": {
      "types": "./dist/services/ai/index.d.ts",
      "default": "./src/services/ai/index.ts"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "default": "./src/integrations/index.ts"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./src/storage/index.ts"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "default": "./src/canvas/index.ts"
    },
    "./temporal": {
      "types": "./dist/temporal/index.d.ts",
      "default": "./src/temporal/index.ts"
    },
    "./temporal/workflows": {
      "types": "./dist/temporal/workflows.d.ts",
      "default": "./src/temporal/workflows.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@openplane/config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
