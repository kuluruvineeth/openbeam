# Multi-stage build for Next.js web app
FROM oven/bun:1.3.2 AS base

# Install dependencies only when needed
FROM base AS deps
WORKDIR /app

# Copy workspace configuration
COPY package.json bun.lock turbo.json ./

# Copy all package.json files (needed for workspace resolution)
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/auth/package.json ./packages/auth/
COPY packages/api/package.json ./packages/api/
COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
COPY apps/fumadocs/package.json ./apps/fumadocs/

# Copy fumadocs config files needed for postinstall script (required during workspace install)
COPY apps/fumadocs/source.config.ts ./apps/fumadocs/
COPY apps/fumadocs/content ./apps/fumadocs/content

# Configure npm registry for HugeIcons Pro (if token provided)
ARG HUGEICONS_PRO_AUTH_TOKEN
RUN if [ -n "$HUGEICONS_PRO_AUTH_TOKEN" ]; then \
        echo "@hugeicons-pro:registry=https://npm.hugeicons.com/" > .npmrc && \
        echo "//npm.hugeicons.com/:_authToken=$HUGEICONS_PRO_AUTH_TOKEN" >> .npmrc; \
    fi

# Install dependencies
RUN bun install --frozen-lockfile

# Build stage
FROM base AS builder
WORKDIR /app

# Make NEXT_PUBLIC_SERVER_URL available at build time for the web bundle
ARG NEXT_PUBLIC_SERVER_URL
ENV NEXT_PUBLIC_SERVER_URL=${NEXT_PUBLIC_SERVER_URL}

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps

# Copy source code
COPY package.json turbo.json bun.lock ./
COPY packages ./packages
COPY apps/web ./apps/web

# Generate Prisma client (needed for build)
WORKDIR /app/packages/db
RUN bun run db:generate

# Build the web app
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run --filter=web build

# Production stage
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static

# Copy public assets for the web app (now present in the project)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

# Set correct permissions
RUN chown -R nextjs:nodejs /app

USER nextjs

# Expose port
EXPOSE 3001

ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD bun run -e "fetch('http://localhost:3001/').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

# Start the server
CMD ["bun", "run", "apps/web/server.js"]

