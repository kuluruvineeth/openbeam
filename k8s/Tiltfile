# ─── Application Images ──────────────────────────────────

_test_ignore = ["**/*.test.ts", "**/*.spec.ts", "**/__tests__/**", "**/*.tmp.*"]

_app_manifests = [
    "apps/cli/package.json",
    "apps/docs/package.json",
    "apps/engine/package.json",
    "apps/sandbox-gateway/package.json",
    "apps/server/package.json",
    "apps/web/package.json",
    "apps/worker/package.json",
]

_shared_only = _app_manifests + [
    "packages",
    "package.json",
    "bun.lock",
    "bun.lockb",
    ".npmrc",
    "tsconfig.json",
]

docker_build("openbeam/server-dev", "..",
    dockerfile="../apps/server/Dockerfile.dev",
    build_args=hugeicons_build_args,
    only=["apps/server"] + _shared_only,
    ignore=_test_ignore,
    live_update=[
        sync("../apps/server/src", "/app/apps/server/src"),
        sync("../packages", "/app/packages"),
        run("cd /app && bun install --frozen-lockfile", trigger=["../apps/server/package.json", "../package.json"]),
    ],
)

docker_build("openbeam/web-dev", "..",
    dockerfile="../apps/web/Dockerfile.dev",
    build_args=hugeicons_build_args,
    only=["apps/web"] + _shared_only,
    ignore=_test_ignore,
    live_update=[
        sync("../apps/web/src", "/app/apps/web/src"),
        sync("../packages", "/app/packages"),
    ],
)

docker_build("openbeam/worker-dev", "..",
    dockerfile="../apps/worker/Dockerfile.dev",
    build_args=hugeicons_build_args,
    only=["apps/worker"] + _shared_only,
    ignore=_test_ignore,
    live_update=[
        sync("../apps/worker/src", "/app/apps/worker/src"),
        sync("../packages", "/app/packages"),
        run("cd /app && bun install --frozen-lockfile", trigger=["../apps/worker/package.json", "../package.json"]),
    ],
)

docker_build("openbeam/engine-dev", "../apps/engine",
    dockerfile="../apps/engine/Dockerfile.cpu",
    live_update=[
        sync("../apps/engine/src", "/app/src"),
    ],
)

docker_build("openbeam/sandbox-gateway", "..",
    dockerfile="../apps/sandbox-gateway/Dockerfile.dev",
    only=["apps/sandbox-gateway"] + _shared_only,
    ignore=_test_ignore,
    live_update=[
        sync("../apps/sandbox-gateway/src", "/app/apps/sandbox-gateway/src"),
        sync("../packages/sandbox/src", "/app/packages/sandbox/src"),
    ],
)

