config.define_bool("monitoring", usage="Enable Prometheus + Grafana + Loki")
config.define_bool("voice", usage="Enable LiveKit + voice agents")
cfg = config.parse()

update_settings(max_parallel_updates=3, k8s_upsert_timeout_secs=120)

def read_env_value_from_local_files(key):
    data = str(local("cat ../.env ../.env.development 2>/dev/null || true", quiet=True))
    prefix = key + "="
    for raw_line in data.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith(prefix):
            value = line[len(prefix):].strip()
            if len(value) >= 2 and ((value[0] == '"' and value[-1] == '"') or (value[0] == "'" and value[-1] == "'")):
                value = value[1:-1]
            return value
    return ""

hugeicons_token = os.getenv("HUGEICONS_PRO_AUTH_TOKEN", "")
if not hugeicons_token:
    hugeicons_token = read_env_value_from_local_files("HUGEICONS_PRO_AUTH_TOKEN")

hugeicons_build_args = {}
if hugeicons_token:
    hugeicons_build_args["HUGEICONS_PRO_AUTH_TOKEN"] = hugeicons_token
else:
    print("HUGEICONS_PRO_AUTH_TOKEN is not set; web resource will be disabled by default.")

