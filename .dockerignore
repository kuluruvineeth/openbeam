# Dependencies (will be installed fresh in containers)
node_modules/
**/node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log

# Build outputs
dist/
**/dist/
.next/
**/.next/
build/
**/build/
out/
**/.out/

# Turbo cache
.turbo/
**/.turbo/

# Cache directories
.cache/
**/.cache/
.mypy_cache/
**/.mypy_cache/
*.log
logs/

# Git (not needed in containers)
.git/
.gitignore
.gitattributes

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment files (handled via build args)
.env*
!.env.example

# Testing files (not needed in production containers)
coverage/
**/.coverage/
*.test.ts
*.spec.ts
test-results/
.nyc_output/

# Documentation (not needed in containers)
*.md
!packages/*/README.md

# Docker files
Dockerfile*
.dockerignore
docker-compose*.yml

# CI/CD (not needed in containers)
.github/

# Infrastructure and monitoring (not needed in app containers)
infra/
monitoring/
references/

# Python virtual environments
.venv/
**/.venv/
**/__pycache__/
*.pyc

# Go build artifacts
apps/cli/openplane

# Development tools
.husky/
lint-staged.config.js
biome.json
bts.jsonc
bunfig.toml

# K8s and Claude config
k8s/
.claude/
