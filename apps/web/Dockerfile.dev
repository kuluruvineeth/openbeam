# =============================================================================
# Web App Development Dockerfile
# =============================================================================
# For use with docker-compose.dev.yml and Docker Compose Watch.
# This image is NOT optimized for production - use the main Dockerfile instead.
# =============================================================================

FROM oven/bun:1.3.2

WORKDIR /app

# Copy package files for dependency installation
COPY package.json bun.lock turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/*/package.json ./packages/

# Install HugeIcons if token provided
ARG HUGEICONS_PRO_AUTH_TOKEN
RUN if [ -n "$HUGEICONS_PRO_AUTH_TOKEN" ]; then \
      printf "@hugeicons-pro:registry=https://npm.hugeicons.com/\n//npm.hugeicons.com/:_authToken=%s\n" "$HUGEICONS_PRO_AUTH_TOKEN" > .npmrc; \
    fi

# Install dependencies
RUN bun install && rm -f .npmrc

# Copy source code (will be overwritten by volume mounts in dev)
COPY . .

# Generate Prisma client
RUN cd packages/db && bun run db:generate

WORKDIR /app/apps/web

EXPOSE 3001

# Start Next.js dev server
CMD ["bun", "run", "dev"]
