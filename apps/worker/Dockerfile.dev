# syntax=docker/dockerfile:1
FROM oven/bun:1.3.2

WORKDIR /app

# Layer 1: Manifests only (changes rarely → cached)
COPY package.json bun.lock .npmr[c] ./
COPY apps/worker/package.json apps/worker/
COPY apps/cli/package.json apps/cli/
COPY apps/docs/package.json apps/docs/
COPY apps/engine/package.json apps/engine/
COPY apps/sandbox-gateway/package.json apps/sandbox-gateway/
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/ai/package.json packages/ai/
COPY packages/analytics/package.json packages/analytics/
COPY packages/api/package.json packages/api/
COPY packages/auth/package.json packages/auth/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/integrations/package.json packages/integrations/
COPY packages/mcp/package.json packages/mcp/
COPY packages/media/package.json packages/media/
COPY packages/observability/package.json packages/observability/
COPY packages/orchestrations/package.json packages/orchestrations/
COPY packages/redis/package.json packages/redis/
COPY packages/sandbox/package.json packages/sandbox/
COPY packages/services/package.json packages/services/
COPY packages/storage/package.json packages/storage/
COPY packages/temporal/package.json packages/temporal/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
COPY packages/vespa/package.json packages/vespa/

# Layer 2: Install deps (cached unless manifests change)
ARG HUGEICONS_PRO_AUTH_TOKEN
RUN if [ -n "$HUGEICONS_PRO_AUTH_TOKEN" ]; then \
      printf "@hugeicons-pro:registry=https://npm.hugeicons.com/\n//npm.hugeicons.com/:_authToken=%s\n" "$HUGEICONS_PRO_AUTH_TOKEN" >> .npmrc; \
    fi
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --filter @openplane/worker && rm -f .npmrc

# Layer 3: Prisma generate (cached unless schema changes)
COPY packages/db/prisma packages/db/prisma
COPY packages/db/prisma.config.ts packages/db/
RUN cd packages/db && bun run db:generate

# Layer 4: Source (rebuilds on code change — layers 1-3 stay cached)
COPY packages/ packages/
COPY apps/worker/ apps/worker/

WORKDIR /app/apps/worker

EXPOSE 9091 9092

CMD ["bun", "run", "--hot", "src/index.ts"]
