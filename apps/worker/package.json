{
  "name": "@openplane/worker",
  "version": "1.0.0",
  "description": "Background worker for syncing and indexing connectors",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "bun run --hot src/index.ts",
    "start": "node dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:fencing": "bun test tests/fencing.test.ts",
    "test:rate-limiting": "bun test tests/rate-limiting.test.ts",
    "test:priority-queue": "bun test tests/priority-queue.test.ts",
    "test:database-schema": "bun test tests/database-schema.test.ts"
