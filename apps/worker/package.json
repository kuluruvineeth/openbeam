  "dependencies": {
    "dotenv": "catalog:",
    "@openplane/analytics": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/integrations": "workspace:*",
    "@openplane/services": "workspace:*",
    "@openplane/vespa": "workspace:*",
    "@openplane/ai": "workspace:*",
    "@openplane/storage": "workspace:*",
    "@openplane/media": "workspace:*",
    "@openplane/temporal": "workspace:*",
    "@temporalio/worker": "^1.12.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
