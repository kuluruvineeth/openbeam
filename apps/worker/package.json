{
  "name": "@openplane/worker",
  "version": "1.0.0",
  "description": "Temporal-based background worker for syncing and indexing connectors",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "node --import tsx src/index.ts",
    "dev:watch": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "worker",
    "temporal",
    "sync",
    "indexing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
