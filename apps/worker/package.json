{
  "name": "@openbeam/worker",
  "version": "1.0.0",
  "description": "Temporal-based background worker for syncing and indexing connectors",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "node --import tsx src/index.ts",
    "dev:watch": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "worker",
    "temporal",
    "sync",
    "indexing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@openbeam/config": "workspace:*",
    "tsdown": "catalog:",
    "tsx": "^4.19.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "@openbeam/analytics": "workspace:*",
    "@openbeam/observability": "workspace:*",
    "@openbeam/db": "workspace:*",
    "@openbeam/integrations": "workspace:*",
    "@openbeam/services": "workspace:*",
    "@openbeam/vespa": "workspace:*",
    "@openbeam/ai": "workspace:*",
    "@openbeam/storage": "workspace:*",
    "@openbeam/media": "workspace:*",
    "@openbeam/temporal": "workspace:*",
    "@temporalio/worker": "~1.15.0",
    "@opentelemetry/api": "^1.9.0",
    "hono": "^4.10.6",
    "prom-client": "^15.1.3"
  }
}
