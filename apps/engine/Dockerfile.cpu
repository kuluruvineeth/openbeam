FROM ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=0 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock README.md ./

RUN uv sync --frozen --no-install-project --no-dev --extra cpu --extra ml

COPY src ./src

RUN uv sync --frozen --no-dev --extra cpu --extra ml


FROM openbeamdevacr.azurecr.io/python:3.12-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    tesseract-ocr \
    libreoffice-calc \
    poppler-utils \
    libmagic1 \
    pandoc \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g 1001 engine && \
    useradd -u 1001 -g engine -s /sbin/nologin -M engine

COPY --from=builder --chown=engine:engine /app/.venv /app/.venv
COPY --from=builder --chown=engine:engine /app/src /app/src

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN mkdir -p /tmp/engine && chown -R engine:engine /tmp/engine

EXPOSE 8000

USER engine

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health')" || exit 1

CMD ["engine-cpu"]
