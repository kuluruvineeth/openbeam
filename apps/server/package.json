    "@openplane/api": "workspace:*",
    "@openplane/auth": "workspace:*",
    "@openplane/connectors": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@openplane/vespa": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
    "@opentelemetry/instrumentation-http": "^0.208.0",
    "@opentelemetry/instrumentation-ioredis": "^0.56.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@scalar/hono-api-reference": "^0.9.25",
