{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@openplane/api": "workspace:*",
    "@openplane/auth": "workspace:*",
    "@openplane/db": "workspace:*",
    "@openplane/redis": "workspace:*",
    "@openplane/vespa": "workspace:*",
    "@trpc/server": "catalog:",
    "argon2": "^0.44.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "prom-client": "^15.1.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "^1.2.6",
    "tsdown": "catalog:",
    "@openplane/config": "workspace:*"
  }
}
