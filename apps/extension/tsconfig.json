{
  "extends": "@openplane/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "react-jsx",
    "types": ["chrome"],
    "strictNullChecks": true
  },
  "include": [
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "wxt.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".wxt"]
}
