PORT=3800
SANDBOX_API_TOKEN=change-me
SANDBOX_REQUIRE_TEAM_ID=true
SANDBOX_DEFAULT_PROVIDER=daytona
SANDBOX_RATE_LIMIT_ENABLED=true
SANDBOX_RATE_LIMIT_WINDOW_MS=60000
SANDBOX_RATE_LIMIT_MAX_REQUESTS=240
SANDBOX_RATE_LIMIT_MAX_EXEC_REQUESTS=90
SANDBOX_RATE_LIMIT_MAX_MUTATION_REQUESTS=120
SANDBOX_RATE_LIMIT_STORE=memory
SANDBOX_OWNERSHIP_STORE=memory
# SANDBOX_REDIS_URL=redis://localhost:6379
# SANDBOX_RATE_LIMIT_KEY_PREFIX=openbeam:sandbox:ratelimit
# SANDBOX_OWNERSHIP_KEY_PREFIX=openbeam:sandbox:ownership
# SANDBOX_OWNERSHIP_TTL_MS=604800000

# Required for SANDBOX_DEFAULT_PROVIDER=daytona.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=
# DAYTONA_JWT_TOKEN=
# DAYTONA_ORGANIZATION_ID=
# DAYTONA_WORKDIR=/home/daytona
# DAYTONA_TEAM_PREFIX=op

# Optional local fallback for development and CI.
# SANDBOX_DEFAULT_PROVIDER=local
