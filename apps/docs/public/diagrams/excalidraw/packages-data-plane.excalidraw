    {
      "id": "t_db2bd964392bd293",
      "type": "text",
      "x": 820,
      "y": 1060,
      "width": 396.8,
      "height": 67.5,
      "text": "Consumers:\n  apps/server (Hono API) -> Cache, PubSub, Rate Limiter\n  packages/temporal (workflows) -> Agent Messaging, Locks, Fence\n  packages/services (connectors) -> Cache, Locks, Dedup\n  apps/web (SSE streams) -> PubSub subscribers",
      "originalText": "Consumers:\n  apps/server (Hono API) -> Cache, PubSub, Rate Limiter\n  packages/temporal (workflows) -> Agent Messaging, Locks, Fence\n  packages/services (connectors) -> Cache, Locks, Dedup\n  apps/web (SSE streams) -> PubSub subscribers",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
