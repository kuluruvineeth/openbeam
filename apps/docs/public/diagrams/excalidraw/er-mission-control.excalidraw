    {
      "id": "t_41babada4b6fd445",
      "type": "text",
      "x": 50,
      "y": 1364,
      "width": 657.2,
      "height": 40.5,
      "text": "Solid boxes = persisted in PostgreSQL (Prisma)        Dashed boxes = ephemeral / runtime (Redis, Temporal)\nPink (#d6336c) = Mission domain    Purple (#9c36b5) = Knowledge domain    Blue (#1971c2) = Auth domain\nSolid arrows = FK relationship     Dashed arrows = soft reference / optional",
      "originalText": "Solid boxes = persisted in PostgreSQL (Prisma)        Dashed boxes = ephemeral / runtime (Redis, Temporal)\nPink (#d6336c) = Mission domain    Purple (#9c36b5) = Knowledge domain    Blue (#1971c2) = Auth domain\nSolid arrows = FK relationship     Dashed arrows = soft reference / optional",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
