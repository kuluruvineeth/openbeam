# syntax=docker/dockerfile:1
FROM oven/bun:1.3.2

WORKDIR /app

# Layer 1: Manifests only (changes rarely → cached)
COPY package.json bun.lock .npmr[c] ./
COPY apps/daemon/package.json apps/daemon/
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/

# Layer 2: Install deps (cached unless manifests change)
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --filter daemon && rm -f .npmrc

# Layer 3: Source (rebuilds on code change — layers 1-2 stay cached)
COPY packages/config/ packages/config/
COPY packages/types/ packages/types/
COPY apps/daemon/ apps/daemon/

WORKDIR /app/apps/daemon

EXPOSE 6868

CMD ["bun", "run", "--hot", "src/index.ts"]
