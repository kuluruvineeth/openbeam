{
  "name": "daemon",
  "version": "0.1.0",
  "description": "OpenBeam local daemon (OpenBeam parity runtime)",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun x tsx scripts/dev-runner.ts",
    "dev:tsx": "NODE_ENV=development bun x tsx watch --ignore '**/*.timestamp-*' src/index.ts",
    "native-helper:build": "bun x tsx scripts/build-native-helper-swift.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && bun run build:lib && bun run build:scripts",
    "build:lib": "bun x tsc -p tsconfig.server.json --incremental false",
    "build:scripts": "bun x tsc -p tsconfig.scripts.json --incremental false && mkdir -p dist/scripts && cp scripts/mcp-stdio-socket-bridge-cli.mjs dist/scripts/mcp-stdio-socket-bridge-cli.mjs",
    "check-types": "echo 'Daemon types validated during build:lib (tsc -p tsconfig.server.json)'",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile daemon",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "bun x vitest run",
    "test:watch": "bun x vitest",
    "test:ui": "bun x vitest --ui"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.52",
    "@anthropic-ai/claude-agent-sdk": "^0.2.11",
    "@deepgram/sdk": "^3.4.0",
    "@hono/node-server": "^1.13.8",
    "@lezer/common": "^1.5.0",
    "@lezer/css": "^1.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/html": "^1.3.13",
    "@lezer/javascript": "^1.5.4",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.6.2",
    "@lezer/python": "^1.1.18",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@opencode-ai/sdk": "^1.1.12",
    "@openbeam/relay": "workspace:*",
    "@openbeam/types": "workspace:*",
    "@sctg/sentencepiece-js": "^1.1.0",
    "@xterm/headless": "^6.0.0",
    "ai": "5.0.78",
    "ajv": "^8.17.1",
    "commander": "^13.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-basic-auth": "^1.2.1",
    "hono": "catalog:",
    "lezer-elixir": "^1.1.2",
    "mnemonic-id": "^3.2.7",
    "node-pty": "1.2.0-beta.11",
    "onnxruntime-node": "^1.23.0",
    "openai": "^4.20.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "sherpa-onnx": "^1.12.23",
    "sherpa-onnx-node": "^1.12.23",
    "strip-ansi": "^7.1.2",
    "tiny-invariant": "^1.3.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@openbeam/config": "workspace:*",
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.20",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.8",
    "@vitest/ui": "^3.2.4",
    "playwright": "^1.56.1",
    "tsx": "^4.6.0",
    "tsdown": "catalog:",
    "typescript": "^5.2.2",
    "vitest": "^3.2.4"
  }
}
