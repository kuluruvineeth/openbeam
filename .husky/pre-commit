#!/bin/sh

# Re-run ultracite only on staged files, then restage them
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$STAGED_FILES" ]; then
  # Run ultracite fix only on staged files (not deleted ones)
  echo "$STAGED_FILES" | xargs bun x ultracite fix
  
  # Restage the formatted files
  echo "$STAGED_FILES" | while IFS= read -r file; do
    if [ -n "$file" ] && [ -f "$file" ]; then
      git add -- "$file"
    fi
  done
fi
